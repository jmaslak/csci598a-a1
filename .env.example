# Copy to .env and fill in. .env is gitignored - never commit it.

# Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# HTTP Basic auth. Set both to require a login; leave both out (delete the
# lines) to run with no login at all. Setting only one makes the server refuse
# to start.
BASIC_AUTH_USER=your-username
BASIC_AUTH_PASS=your-password
